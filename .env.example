# --- Shared ---
ENVIRONMENT=development

# --- consent-management ---
CONSENT_DB_URL=sqlite:///./data/consent.db

# --- connector-config ---
CONNECTOR_DB_URL=sqlite:///./data/connectors.db

# --- registry-intelligence ---
REGISTRY_DB_URL=sqlite:///./data/registry.db
MATCH_CONFIDENCE_THRESHOLD=0.85

# --- delivery-intelligence ---
DELIVERY_DB_URL=sqlite:///./data/delivery.db

# --- sunbird-adapter ---
# Real Sunbird RC's `registry` service, reachable once both this platform and
# Sunbird RC join the shared `social-registry-net` network — see deploy/README.md.
# Without a real Sunbird RC running, calls here just fail gracefully (logged as
# "unreachable"), which is fine for local dev of the platform's own logic.
SUNBIRD_RC_BASE_URL=http://registry:8091
SUNBIRD_RC_API_KEY=

# --- openg2p-sync ---
# Real OpenG2P's `odoo` service, reachable the same way — see deploy/openg2p/README.md.
OPENG2P_BASE_URL=http://odoo:8069
OPENG2P_API_KEY=
OPENG2P_SYNC_MODE=manual
OPENG2P_SYNC_CRON=0 */6 * * *

# --- digit-adapter ---
# See services/digit-adapter/README.md for why these two must be obtained from
# your DIGIT deployment's own setup — this adapter can't generate them.
DIGIT_BASE_URL=http://localhost:8083
DIGIT_AUTH_TOKEN=
DIGIT_TENANT_ID=pilot
DIGIT_BUSINESS_SERVICE=REGISTRY_VERIFICATION

# --- inji-adapter ---
# See services/inji-adapter/README.md — INJI_VERIFY_PATH is an unconfirmed guess,
# check it against your deployed Inji Verify version before relying on it.
INJI_CERTIFY_BASE_URL=http://localhost:8084
INJI_VERIFY_BASE_URL=http://localhost:8085
INJI_VERIFY_PATH=/v1/verify/vc-verification
INJI_CLIENT_ID=
INJI_CLIENT_SECRET=
INJI_TOKEN_URL=

# --- api-gateway ---
GATEWAY_PORT=8000
# Leave empty for local dev (no auth). Set for any real deployment — see
# services/api-gateway/README.md for the frontend-can't-hold-secrets caveat.
GATEWAY_API_KEY=
CONSENT_SERVICE_URL=http://consent-management:8001
CONNECTOR_SERVICE_URL=http://connector-config:8002
REGISTRY_SERVICE_URL=http://registry-intelligence:8003
DELIVERY_SERVICE_URL=http://delivery-intelligence:8004
OPENG2P_SYNC_SERVICE_URL=http://openg2p-sync:8005
SUNBIRD_ADAPTER_SERVICE_URL=http://sunbird-adapter:8006
DIGIT_ADAPTER_SERVICE_URL=http://digit-adapter:8007
INJI_ADAPTER_SERVICE_URL=http://inji-adapter:8008
